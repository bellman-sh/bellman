#!/bin/sh
# Launch Claude Code. Kept so that scripts and aliases that call it keep working.
#
# It used to add --dangerously-load-development-channels server:bellman, so that the
# bridge could push peer events into the session as a channel. MCP 2026-07-28 lets a
# server send no notification the client did not ask for, and Claude Code does not
# register a server on that revision as a channel, so the bridge stopped being one.
# Peer events now reach the session through the Bellman plugin's monitor, which
# prints each one as it lands, and through the Stop hook at the end of a turn.
#
#   bellman-claude            # the same as: claude
#   bellman-claude --resume   # flags pass through
set -eu

echo "bellman-claude: Bellman no longer needs a channel flag; this runs plain 'claude'. For live peer events, install the plugin: claude plugin install bellman --marketplace bellman-sh/bellman" >&2
exec claude "$@"
