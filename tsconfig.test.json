{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"]
  },
  // tests/store-do-wiring.test.ts, tests/worker-ws.test.ts and tests/hosted-seat-wiring.test.ts
  // are the tests that import a Workers file (src/store-do.ts, src/worker.ts, src/host-do.ts).
  // Any import pulls @cloudflare/workers-types into this `types: ["node"]` program and breaks
  // an unrelated file (scripts/rotate-key.ts:42, TS2554 on randomBytes); keeping the Workers
  // files themselves out of this program avoids the same clash. Vitest still runs the tests;
  // only tsc skips them. Delete the test entries when Worker-side tests get their own
  // tsconfig project. #12 has since created worker-tests/ with its own program, so they
  // could likely go now; that migration is not part of this change.
  // `src/blobs-r2.ts` (#183) is a Workers file for the same reason, and is kept out the same way.
  "exclude": [
    "src/worker.ts",
    "src/store-do.ts",
    "src/host-do.ts",
    "src/oauth/store.ts",
    "src/blobs-r2.ts",
    "tests/store-do-wiring.test.ts",
    "tests/worker-ws.test.ts",
    "tests/hosted-seat-wiring.test.ts"
  ],
  "include": ["src", "tests", "scripts", "vitest.config.ts"]
}
